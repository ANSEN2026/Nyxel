{
  "name": "nyxel",
  "productName": "Texture map",
  "version": "1.1.0",
  "description": "Texture map - texture, model, drawing and video toolkit",
  "author": "Texture map",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/run-electron.cjs\"",
    "build:renderer": "vite build",
    "build:electron": "node scripts/clean-dist.cjs dist-electron && tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && node scripts/run-electron.cjs",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:appx": "npm run build && node scripts/build-appx.cjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "undici": "^7.30.2",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@comfyorg/fbx-exporter-three": "^1.0.2",
    "@types/node": "^22.18.0",
    "@types/three": "^0.187.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.nyxel.app",
    "productName": "Texture map",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/selector.html",
      "electron/editor.html",
      "resources/**/*",
      "!resources/official-textures/**/*",
      "!resources/official-models/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/README*",
      "!node_modules/**/CHANGELOG*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/official-textures",
        "to": "official-textures"
      },
      {
        "from": "resources/official-models",
        "to": "official-models"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
